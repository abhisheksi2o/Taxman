# ---------------------------------------------------------------------------
# ASTRA Tax – environment configuration (copy to backend/.env)
# Never commit real secrets. Never expose any of these to the frontend bundle.
# ---------------------------------------------------------------------------

# development | production
ASTRA_ENV=development

# Fernet key for encrypting the taxpayer model, PAN and document blobs at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. In development an ephemeral key is generated under backend/data/.
ASTRA_ENCRYPTION_KEY=

# Database. Defaults to a local SQLite file for the prototype; use PostgreSQL in production.
# DATABASE_URL=postgresql+psycopg://astra:astra@localhost:5432/astra
DATABASE_URL=sqlite:///./data/astra.db

# Object storage for uploaded documents (encrypted at rest).
# local  -> ASTRA_STORAGE_DIR ;  s3 -> ASTRA_S3_BUCKET (+ standard AWS credentials via the environment)
ASTRA_STORAGE_BACKEND=local
ASTRA_STORAGE_DIR=./data/documents
ASTRA_S3_BUCKET=

# Session security
ASTRA_SESSION_TTL_HOURS=12
ASTRA_COOKIE_SECURE=false          # set true behind HTTPS
ASTRA_ALLOWED_ORIGINS=http://localhost:3000

# Data retention (days) for cases that have been marked for deletion / inactive demo cases
ASTRA_RETENTION_DAYS=30

# Demo & developer features
ASTRA_DEMO_MODE=true               # enables "Continue with a demo workspace" login
ASTRA_DEV_MODE=true                # enables the developer-only AI evaluation screen

# AI layer (optional). Without a key Astra runs in deterministic grounded mode.
ANTHROPIC_API_KEY=
ASTRA_LLM_MODEL=claude-opus-5
ASTRA_LLM_ENABLED=auto             # auto | on | off

# Max upload size in MB
ASTRA_MAX_UPLOAD_MB=15
